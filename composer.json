{
    "name": "heyosseus/filum",
    "description": "Broadcasting-agnostic real-time chat between admin users, inside a Filament panel. Works with Reverb, Pusher, Ably or no broadcaster at all. Dark-first, English and Georgian.",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "chat",
        "messaging",
        "broadcasting",
        "reverb",
        "livewire",
        "real-time",
        "presence"
    ],
    "license": "MIT",
    "homepage": "https://github.com/heyosseus/filum",
    "support": {
        "issues": "https://github.com/heyosseus/filum/issues",
        "source": "https://github.com/heyosseus/filum"
    },
    "authors": [
        {
            "name": "heyosseus",
            "email": "ratiruxadzee@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.0 || ^5.0",
        "illuminate/broadcasting": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.0 || ^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0 || ^5.0",
        "rector/rector": "^2.0"
    },
    "suggest": {
        "laravel/reverb": "Free, self-hosted WebSocket server for real-time delivery. Filum works without it, falling back to polling."
    },
    "autoload": {
        "psr-4": {
            "Heyosseus\\Filum\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Heyosseus\\Filum\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Heyosseus\\Filum\\FilumServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "pint",
        "refacto": "rector",
        "test:lint": "pint --test",
        "test:refacto": "rector --dry-run",
        "test:types": "phpstan analyse --ansi --memory-limit=512M",
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:unit": "pest --colors=always --coverage --min=100",
        "test:tia": "pest --colors=always --parallel --tia",
        "test": [
            "@test:refacto",
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ]
    }
}
